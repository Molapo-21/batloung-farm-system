# Server
PORT=3000
NODE_ENV=development

# TiDB Cloud Serverless / MySQL (never commit the real .env file)
# TiDB Serverless default port is 4000; enable SSL for TiDB Cloud.
DB_HOST=localhost
DB_PORT=4000
DB_USER=root
DB_PASSWORD=your_tidb_password
DB_NAME=batloung_farm
DB_CONNECTION_LIMIT=3
DB_SSL=true

# Default threshold used by GET /api/stock/low when ?threshold is not supplied
LOW_STOCK_THRESHOLD=10

# Login (JWT) - use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# Only used by scripts/demo-transactions.js
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345678
